{"id":"comp:thesis-and-positioning:01","discipline":"Meta","subclass":"CompositionRule","category":"Thesis and positioning","rule_text":"State one clear, sharp key idea and know what it is by the time you finish.","source":"SPJ","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:thesis-and-positioning:02","discipline":"Meta","subclass":"CompositionRule","category":"Thesis and positioning","rule_text":"Write the contribution list first and let it drive the paper's structure.","source":"SPJ","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:thesis-and-positioning:03","discipline":"Meta","subclass":"CompositionRule","category":"Thesis and positioning","rule_text":"Phrase each contribution as a refutable claim with a forward reference to the section that substantiates it.","source":"SPJ","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:thesis-and-positioning:04","discipline":"Meta","subclass":"CompositionRule","category":"Thesis and positioning","rule_text":"State a purpose, problem, objective, or research question and explain why it is important.","source":"SIGSOFT Gen. Std.","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:thesis-and-positioning:05","discipline":"Meta","subclass":"CompositionRule","category":"Thesis and positioning","rule_text":"Make the abstract and introduction claims match the paper's actual contributions and scope.","source":"NeurIPS Checklist §1","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:thesis-and-positioning:06","discipline":"Meta","subclass":"CompositionRule","category":"Thesis and positioning","rule_text":"Mark aspirational or unattained goals explicitly as such.","source":"NeurIPS Checklist §1","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:abstract:01","discipline":"Meta","subclass":"CompositionRule","category":"Abstract","rule_text":"Keep the abstract to roughly 150–250 words in a single paragraph without citations.","source":"IEEE Style","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:abstract:02","discipline":"Meta","subclass":"CompositionRule","category":"Abstract","rule_text":"Summarize purpose, methods, results, and conclusions in the abstract.","source":"IEEE Style","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:abstract:03","discipline":"Meta","subclass":"CompositionRule","category":"Abstract","rule_text":"Ensure every claim in the abstract is substantiated by the paper's results.","source":"NeurIPS Checklist §1","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:introduction:01","discipline":"Meta","subclass":"CompositionRule","category":"Introduction","rule_text":"Tell a story: problem, motivation, unsolved status, your idea, validation, comparison.","source":"SPJ","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:introduction:02","discipline":"Meta","subclass":"CompositionRule","category":"Introduction","rule_text":"Place the bulleted contribution list in the introduction with forward references.","source":"SPJ","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:introduction:03","discipline":"Meta","subclass":"CompositionRule","category":"Introduction","rule_text":"Explain intuition with a concrete example before you generalize.","source":"SPJ","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:related-work:01","discipline":"Meta","subclass":"CompositionRule","category":"Related work","rule_text":"Place related work after your technical content rather than immediately after the introduction.","source":"SPJ","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:related-work:02","discipline":"Meta","subclass":"CompositionRule","category":"Related work","rule_text":"Acknowledge competitors' strengths generously while stating what you improve.","source":"SPJ","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:related-work:03","discipline":"Meta","subclass":"CompositionRule","category":"Related work","rule_text":"Cite all related work, including your own prior submissions.","source":"ICLR 2026","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:related-work:04","discipline":"Meta","subclass":"CompositionRule","category":"Related work","rule_text":"Refer to your own prior work in the third person to preserve anonymity.","source":"ICLR 2026; SIGCOMM 2026","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:method-presentation:01","discipline":"Meta","subclass":"CompositionRule","category":"Method presentation","rule_text":"Take the most direct route to the idea rather than replaying your discovery process.","source":"SPJ","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:method-presentation:02","discipline":"Meta","subclass":"CompositionRule","category":"Method presentation","rule_text":"Name the methodology and show it is appropriate (not necessarily optimal) for the stated purpose.","source":"SIGSOFT Gen. Std.","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:method-presentation:03","discipline":"Meta","subclass":"CompositionRule","category":"Method presentation","rule_text":"Describe in detail what, where, when, and how data were collected, and how they were analyzed.","source":"SIGSOFT Gen. Std.","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:method-presentation:04","discipline":"Meta","subclass":"CompositionRule","category":"Method presentation","rule_text":"State the full set of assumptions for every theoretical result and include complete proofs (main paper or appendix).","source":"NeurIPS Checklist §3","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:method-presentation:05","discipline":"Meta","subclass":"CompositionRule","category":"Method presentation","rule_text":"When the full proof lives in the appendix, include a proof sketch in the main text.","source":"NeurIPS Checklist §3","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:claims-and-evidence:01","discipline":"Meta","subclass":"CompositionRule","category":"Claims and evidence","rule_text":"Present results that directly address the stated research questions.","source":"SIGSOFT Gen. Std.","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:claims-and-evidence:02","discipline":"Meta","subclass":"CompositionRule","category":"Claims and evidence","rule_text":"State conclusions that link back to the research question and are supported by explicit evidence.","source":"SIGSOFT Gen. Std.","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:claims-and-evidence:03","discipline":"Meta","subclass":"CompositionRule","category":"Claims and evidence","rule_text":"Note the important assumptions and limitations attached to each stated contribution.","source":"NeurIPS Checklist §1","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:claims-and-evidence:04","discipline":"Meta","subclass":"CompositionRule","category":"Claims and evidence","rule_text":"Do not let language mislead about what the evidence supports.","source":"SIGSOFT Gen. Std.","severity":"info","status":"open","kind":"Don't","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:empirical-rigor:01","discipline":"Meta","subclass":"CompositionRule","category":"Empirical rigor","rule_text":"Specify all training details: data splits, hyperparameters, and how hyperparameters were chosen.","source":"NeurIPS Checklist §6","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:empirical-rigor:02","discipline":"Meta","subclass":"CompositionRule","category":"Empirical rigor","rule_text":"Report error bars, confidence intervals, or significance tests for main claims, and state which variability they capture.","source":"NeurIPS Checklist §7","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:empirical-rigor:03","discipline":"Meta","subclass":"CompositionRule","category":"Empirical rigor","rule_text":"Explain how error bars were computed (formula, library, bootstrap) and state distributional assumptions.","source":"NeurIPS Checklist §7","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:empirical-rigor:04","discipline":"Meta","subclass":"CompositionRule","category":"Empirical rigor","rule_text":"Distinguish standard deviation from standard error when reporting variability.","source":"NeurIPS Checklist §7","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:empirical-rigor:05","discipline":"Meta","subclass":"CompositionRule","category":"Empirical rigor","rule_text":"Do not use symmetric error bars that imply impossible values (e.g., accuracy > 1).","source":"NeurIPS Checklist §7","severity":"info","status":"open","kind":"Don't","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:empirical-rigor:06","discipline":"Meta","subclass":"CompositionRule","category":"Empirical rigor","rule_text":"Enumerate and validate the assumptions of any statistical tests used.","source":"SIGSOFT Gen. Std.","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:empirical-rigor:07","discipline":"Meta","subclass":"CompositionRule","category":"Empirical rigor","rule_text":"Report compute resources: hardware type, memory, storage, per-run and total wall-clock.","source":"NeurIPS Checklist §8","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:empirical-rigor:08","discipline":"Meta","subclass":"CompositionRule","category":"Empirical rigor","rule_text":"Disclose whether the full project consumed more compute than the reported experiments.","source":"NeurIPS Checklist §8","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:empirical-rigor:09","discipline":"Meta","subclass":"CompositionRule","category":"Empirical rigor","rule_text":"Treat failed and partial replications as first-class contributions when reproducibility is the focus.","source":"MLRC 2026","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:threats-and-limitations:01","discipline":"Meta","subclass":"CompositionRule","category":"Threats and limitations","rule_text":"Include a separate Limitations section covering assumptions, robustness, and scope.","source":"NeurIPS Checklist §2","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:threats-and-limitations:02","discipline":"Meta","subclass":"CompositionRule","category":"Threats and limitations","rule_text":"Reflect on how the paper's assumptions might fail in practice.","source":"NeurIPS Checklist §2","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:threats-and-limitations:03","discipline":"Meta","subclass":"CompositionRule","category":"Threats and limitations","rule_text":"Disclose all major limitations of the study.","source":"SIGSOFT Gen. Std.","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:threats-and-limitations:04","discipline":"Meta","subclass":"CompositionRule","category":"Threats and limitations","rule_text":"Describe attempts to investigate or mitigate the limitations you disclose.","source":"SIGSOFT Gen. Std. (desirable)","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:figures-and-tables:01","discipline":"Meta","subclass":"CompositionRule","category":"Figures and tables","rule_text":"Place figure captions below figures and table titles above tables.","source":"IEEE Style","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:figures-and-tables:02","discipline":"Meta","subclass":"CompositionRule","category":"Figures and tables","rule_text":"Write captions descriptive enough to stand alone from the body text.","source":"IEEE Style","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:figures-and-tables:03","discipline":"Meta","subclass":"CompositionRule","category":"Figures and tables","rule_text":"Reference every figure and table from the running text.","source":"NeurIPS Checklist §7","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:figures-and-tables:04","discipline":"Meta","subclass":"CompositionRule","category":"Figures and tables","rule_text":"Do not use visualizations that misrepresent the underlying data.","source":"SIGSOFT Gen. Std.","severity":"info","status":"open","kind":"Don't","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:language-and-register:01","discipline":"Meta","subclass":"CompositionRule","category":"Language and register","rule_text":"Prefer active voice in technical writing and use first person when discussing your own work.","source":"IEEE Style","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:language-and-register:02","discipline":"Meta","subclass":"CompositionRule","category":"Language and register","rule_text":"Define every acronym on first use.","source":"IEEE Style","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:language-and-register:03","discipline":"Meta","subclass":"CompositionRule","category":"Language and register","rule_text":"Define every symbol before it appears in an equation.","source":"IEEE Style","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:language-and-register:04","discipline":"Meta","subclass":"CompositionRule","category":"Language and register","rule_text":"Use SI units consistently.","source":"IEEE Style","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:language-and-register:05","discipline":"Meta","subclass":"CompositionRule","category":"Language and register","rule_text":"Number equations at the right margin and cross-reference them by number.","source":"IEEE Style","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:language-and-register:06","discipline":"Meta","subclass":"CompositionRule","category":"Language and register","rule_text":"Keep each paragraph to a single topic with the first sentence capturing its main idea.","source":"Zobel 2014","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:language-and-register:07","discipline":"Meta","subclass":"CompositionRule","category":"Language and register","rule_text":"Keep titles concise, informative, and relevant to the actual content.","source":"Zobel 2014; IEEE Style","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:language-and-register:08","discipline":"Meta","subclass":"CompositionRule","category":"Language and register","rule_text":"Do not let grammar problems substantially hinder understanding.","source":"SIGSOFT Gen. Std.","severity":"info","status":"open","kind":"Don't","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:citations-and-references:01","discipline":"Meta","subclass":"CompositionRule","category":"Citations and references","rule_text":"Use IEEE-style numbered citations in brackets with a numeric bibliography at the end (IEEE venues).","source":"IEEE Style","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:citations-and-references:02","discipline":"Meta","subclass":"CompositionRule","category":"Citations and references","rule_text":"Cite the creators of code, datasets, and models you use, giving URLs and version.","source":"NeurIPS Checklist §12","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:citations-and-references:03","discipline":"Meta","subclass":"CompositionRule","category":"Citations and references","rule_text":"State the license (e.g., CC-BY 4.0) of every existing asset you use, and both original and derived licenses when repackaging.","source":"NeurIPS Checklist §12","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:citations-and-references:04","discipline":"Meta","subclass":"CompositionRule","category":"Citations and references","rule_text":"Submit the compiled `.bbl` alongside the paper so hallucinated GenAI references can be detected.","source":"SIGCOMM 2026","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:reproducibility:01","discipline":"Meta","subclass":"CompositionRule","category":"Reproducibility","rule_text":"Provide a reproducibility path proportional to the contribution: full architecture description, model access, or code and instructions.","source":"NeurIPS Checklist §4","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:reproducibility:02","discipline":"Meta","subclass":"CompositionRule","category":"Reproducibility","rule_text":"Ship code, data, and exact commands/environment specs sufficient to reproduce the main results and baselines.","source":"NeurIPS Checklist §5","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:reproducibility:03","discipline":"Meta","subclass":"CompositionRule","category":"Reproducibility","rule_text":"Note which experiments are and are not reproducible if only a subset is.","source":"NeurIPS Checklist §5","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:reproducibility:04","discipline":"Meta","subclass":"CompositionRule","category":"Reproducibility","rule_text":"Anonymize the code and asset URLs at submission time.","source":"NeurIPS Checklist §5, §13","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:reproducibility:05","discipline":"Meta","subclass":"CompositionRule","category":"Reproducibility","rule_text":"Archive the released implementation in the Software Heritage Archive and cite the archive identifier.","source":"NeurIPS 2026 Handbook; MLRC 2026","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:reproducibility:06","discipline":"Meta","subclass":"CompositionRule","category":"Reproducibility","rule_text":"Include a reproducibility statement at the end of the main text before references (ICLR); it does not count toward the page limit.","source":"ICLR 2026","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:reproducibility:07","discipline":"Meta","subclass":"CompositionRule","category":"Reproducibility","rule_text":"Document released assets with a structured template (Datasheet, Model Card).","source":"NeurIPS Checklist §13; NeurIPS CoE","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:reproducibility:08","discipline":"Meta","subclass":"CompositionRule","category":"Reproducibility","rule_text":"Describe consent mechanisms when released assets contain personal data.","source":"NeurIPS Checklist §13","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:reproducibility:09","discipline":"Meta","subclass":"CompositionRule","category":"Reproducibility","rule_text":"Do not answer \"No\" to code release without a real reason such as proprietary code.","source":"NeurIPS Checklist §5","severity":"info","status":"open","kind":"Don't","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:mechanics:01","discipline":"Meta","subclass":"CompositionRule","category":"Mechanics","rule_text":"Use the official LaTeX template and submit a single PDF (NeurIPS: 9 content pages; supplementary ZIP ≤100 MB).","source":"NeurIPS 2026 Handbook","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:mechanics:02","discipline":"Meta","subclass":"CompositionRule","category":"Mechanics","rule_text":"Respect the page limit exactly (ICLR 2026: 9 pages at submission, 10 at rebuttal/camera-ready; references unlimited).","source":"ICLR 2026","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:mechanics:03","discipline":"Meta","subclass":"CompositionRule","category":"Mechanics","rule_text":"For IEEE venues, use double-column, 10-pt Times layout and submit both source and PDF.","source":"IEEE Style","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:mechanics:04","discipline":"Meta","subclass":"CompositionRule","category":"Mechanics","rule_text":"Anonymize authors, affiliations, and identifying links; do not publicize submissions where the PC would see them.","source":"ICLR 2026; SIGCOMM 2026","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:ethics-and-disclosures:01","discipline":"Meta","subclass":"CompositionRule","category":"Ethics and disclosures","rule_text":"Read and conform to the NeurIPS Code of Ethics and confirm compliance in the checklist.","source":"NeurIPS Checklist §9; NeurIPS CoE","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:ethics-and-disclosures:02","discipline":"Meta","subclass":"CompositionRule","category":"Ethics and disclosures","rule_text":"Discuss potential negative societal impacts, including malicious use, discrimination, privacy, and security harms.","source":"NeurIPS Checklist §10","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:ethics-and-disclosures:03","discipline":"Meta","subclass":"CompositionRule","category":"Ethics and disclosures","rule_text":"Put safeguards (gated release, access controls, monitoring) in place for models with high misuse risk.","source":"NeurIPS Checklist §11","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:ethics-and-disclosures:04","discipline":"Meta","subclass":"CompositionRule","category":"Ethics and disclosures","rule_text":"Include full participant instructions and screenshots for crowdsourced work and pay at least regional minimum wage.","source":"NeurIPS Checklist §14; NeurIPS CoE","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:ethics-and-disclosures:05","discipline":"Meta","subclass":"CompositionRule","category":"Ethics and disclosures","rule_text":"Obtain and disclose IRB (or equivalent) approval when required.","source":"NeurIPS Checklist §15","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:ethics-and-disclosures:06","discipline":"Meta","subclass":"CompositionRule","category":"Ethics and disclosures","rule_text":"Declare LLM usage in the paper when it is an important, original, or non-standard component of the method.","source":"NeurIPS Checklist §16; NeurIPS 2026 Handbook","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:ethics-and-disclosures:07","discipline":"Meta","subclass":"CompositionRule","category":"Ethics and disclosures","rule_text":"Disclose in an appendix any significant role LLMs played in research ideation or writing (ICLR).","source":"ICLR 2026","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:ethics-and-disclosures:08","discipline":"Meta","subclass":"CompositionRule","category":"Ethics and disclosures","rule_text":"Do not list an LLM as an author.","source":"ICLR 2026","severity":"info","status":"open","kind":"Don't","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:ethics-and-disclosures:09","discipline":"Meta","subclass":"CompositionRule","category":"Ethics and disclosures","rule_text":"Include an ethics statement in the main body — either declaring no concerns or discussing them (SIGCOMM).","source":"SIGCOMM 2026","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:ethics-and-disclosures:10","discipline":"Meta","subclass":"CompositionRule","category":"Ethics and disclosures","rule_text":"Minimize exposure of personally identifiable information and obtain explicit consent when identities appear.","source":"NeurIPS CoE","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:ethics-and-disclosures:11","discipline":"Meta","subclass":"CompositionRule","category":"Ethics and disclosures","rule_text":"Discontinue use of deprecated datasets except for audits or critical assessments.","source":"NeurIPS CoE","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:ethics-and-disclosures:12","discipline":"Meta","subclass":"CompositionRule","category":"Ethics and disclosures","rule_text":"Inspect models and datasets for encoded bias affecting protected characteristics.","source":"NeurIPS CoE","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
{"id":"comp:ethics-and-disclosures:13","discipline":"Meta","subclass":"CompositionRule","category":"Ethics and disclosures","rule_text":"Follow responsible-disclosure procedures for any security vulnerabilities the work reveals.","source":"NeurIPS CoE","severity":"info","status":"open","kind":"Do","added_at":"2026-09-13","updated_at":"2026-09-13"}
